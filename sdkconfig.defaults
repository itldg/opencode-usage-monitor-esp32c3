# LVGL color depth 16 (ST7789 RGB565)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64

# UI uses Montserrat 14/16/20 (14 is default on, 16/20 need explicit enable)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y

# Enable HTTPS via certificate bundle (needed for opencode.ai)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Reduce log verbosity on release builds (optional)
# CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# SPI flash size (立创实战派 ESP32-C3 板载 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y